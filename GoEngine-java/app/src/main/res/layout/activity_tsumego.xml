<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#061F19">
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/jade_forest_scrim"
        android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="55dp"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/tsumegoBack"
                android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/btn_round_back"
                android:contentDescription="返回"/>
            <TextView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp" android:background="@drawable/jade_dark_title"
                android:gravity="center" android:text="死 活 训 练"
                android:textColor="#174534" android:textSize="20sp"
                android:textStyle="bold" android:fontFamily="serif"/>
            <ImageButton android:id="@+id/tsumegoResultsTop"
                android:layout_width="42dp" android:layout_height="42dp"
                android:padding="9dp" android:background="@drawable/jade_dark_card"
                android:src="@drawable/ic_difficulty_gold" android:contentDescription="查看训练成果"/>
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:scrollbars="none" android:fillViewport="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="53dp"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:layout_marginTop="5dp" android:layout_marginBottom="7dp"
                    android:background="@drawable/jade_dark_card" android:gravity="center_vertical"
                    android:paddingStart="9dp" android:paddingEnd="9dp">
                    <ImageView android:layout_width="25dp" android:layout_height="25dp"
                        android:src="@drawable/ic_training_ivory"
                        android:importantForAccessibility="no" android:contentDescription="@null"/>
                    <TextView android:id="@+id/tsumegoProgress"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="match_parent" android:gravity="center"
                        android:text="第 1 / 8 题 · 已完成 0 / 8"
                        android:textColor="#F5DB94" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/tsumegoQuestion"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="60dp" android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp" android:layout_marginBottom="6dp"
                    android:gravity="center" android:padding="8dp"
                    android:background="@drawable/jade_dark_card"
                    android:text="黑先，寻找正确的一手" android:textColor="#F8E7C0"
                    android:textSize="14sp" android:textStyle="bold"/>
                <com.badukai.ui.JadeSquareBoardFrame android:id="@+id/tsumegoBoardFrame"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:layout_marginBottom="7dp" android:padding="7dp"
                    android:background="@drawable/jade_game_wood_panel">
                    <com.badukai.ui.GoBoardView android:id="@+id/tsumegoBoard"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:contentDescription="9路死活题，点击交叉点作答"/>
                </com.badukai.ui.JadeSquareBoardFrame>
                <TextView android:id="@+id/tsumegoMessage"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp" android:layout_marginBottom="6dp"
                    android:padding="8dp" android:background="@drawable/jade_dark_card"
                    android:gravity="center" android:text="点击棋盘落子"
                    android:textColor="#DEE5CF" android:textSize="12sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:orientation="horizontal">
                    <Button android:id="@+id/tsumegoHint"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="43dp" android:layout_marginEnd="3dp"
                        android:background="@drawable/jade_game_white_button"
                        android:text="提示" android:textAllCaps="false"
                        android:textSize="13sp" android:textColor="#194F3B"
                        android:minWidth="0dp" android:minHeight="0dp"/>
                    <Button android:id="@+id/tsumegoReset"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="43dp" android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp" android:background="@drawable/jade_game_white_button"
                        android:text="重做" android:textAllCaps="false"
                        android:textSize="13sp" android:textColor="#194F3B"
                        android:minWidth="0dp" android:minHeight="0dp"/>
                    <Button android:id="@+id/tsumegoExplain"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="43dp" android:layout_marginStart="3dp"
                        android:background="@drawable/jade_game_white_button"
                        android:text="答案解析" android:textAllCaps="false"
                        android:textSize="13sp" android:textColor="#194F3B"
                        android:minWidth="0dp" android:minHeight="0dp"
                        android:enabled="false"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:orientation="horizontal">
                    <Button android:id="@+id/tsumegoPrev"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="43dp" android:layout_marginEnd="3dp"
                        android:background="@drawable/jade_game_white_button"
                        android:text="上一题" android:textAllCaps="false"
                        android:textSize="13sp" android:textColor="#194F3B"
                        android:minWidth="0dp" android:minHeight="0dp"/>
                    <Button android:id="@+id/tsumegoNext"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="43dp" android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp" android:background="@drawable/jade_game_white_button"
                        android:text="下一题" android:textAllCaps="false"
                        android:textSize="13sp" android:textColor="#194F3B"
                        android:minWidth="0dp" android:minHeight="0dp"/>
                    <Button android:id="@+id/tsumegoResults"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="43dp" android:layout_marginStart="3dp"
                        android:background="@drawable/jade_game_white_button"
                        android:text="训练结果" android:textAllCaps="false"
                        android:textSize="13sp" android:textColor="#194F3B"
                        android:minWidth="0dp" android:minHeight="0dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <com.badukai.ui.JadeBottomNavView android:id="@+id/tsumegoSharedNav"
            android:layout_width="match_parent" android:layout_height="70dp"
            android:layout_marginStart="9dp" android:layout_marginEnd="9dp"
            android:layout_marginBottom="3dp"/>
    </LinearLayout>
</FrameLayout>
