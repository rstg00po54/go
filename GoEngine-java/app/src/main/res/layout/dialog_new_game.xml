<?xml version="1.0" encoding="utf-8"?>
<!-- Jade new-game v2: scrollable sections; preserve control IDs and NPU selection. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/jade_dialog_surface" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="84dp"
            android:orientation="vertical" android:gravity="center"
            android:background="@drawable/jade_game_header"
            android:paddingStart="18dp" android:paddingEnd="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="38dp"
                android:gravity="center" android:text="新 开 一 局"
                android:textColor="#F5E4B6" android:textSize="22sp"
                android:textStyle="bold"/>
            <TextView android:id="@+id/deviceModelText"
                android:layout_width="match_parent" android:layout_height="24dp"
                android:gravity="center" android:singleLine="true"
                android:ellipsize="end" android:textSize="11sp"
                android:textColor="#D6E8D1"/>
        </LinearLayout>
        <ScrollView android:id="@+id/newGameSettingsScroll"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:fillViewport="false"
            android:clipToPadding="false" android:fadeScrollbars="true">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="17dp" android:paddingEnd="17dp"
                android:paddingBottom="14dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="33dp"
             android:orientation="horizontal" android:gravity="center_vertical"
             android:layout_marginTop="12dp" android:paddingStart="5dp">
             <View android:layout_width="3dp" android:layout_height="15dp"
                 android:background="#B39A62"/>
             <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                 android:layout_marginStart="8dp" android:text="对弈设置"
                 android:textStyle="bold" android:textSize="14sp" android:textColor="#28543F"/>
             <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                 android:layout_weight="1" android:gravity="end"
                 android:paddingEnd="5dp" android:text="一方落子 · 万般变化"
                 android:textSize="10sp" android:textColor="#748575"/>
          </LinearLayout>
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:background="@drawable/jade_dialog_card">
                    <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="59dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="12dp" android:paddingEnd="12dp">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="棋盘路数" android:textColor="#385743"
                    android:textSize="13sp"/>
                <FrameLayout
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1">
                    <Spinner android:id="@+id/sizeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/jade_dialog_field"
                        android:paddingStart="12dp" android:paddingEnd="29dp"
                        android:spinnerMode="dropdown"/>
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="match_parent" android:layout_gravity="end"
                        android:gravity="center" android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no" android:text="⌄"
                        android:textColor="#3C7259" android:textSize="21sp"/>
                </FrameLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
            android:background="#E6DFC9"/>
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="60dp" android:orientation="horizontal"
                        android:gravity="center_vertical" android:paddingStart="12dp"
                        android:paddingEnd="10dp">
                        <TextView android:layout_width="80dp"
                            android:layout_height="wrap_content" android:text="执棋颜色"
                            android:textColor="#385743" android:textSize="13sp"/>
                        <RadioGroup android:id="@+id/colorGroup"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical" android:orientation="horizontal">
                            <RadioButton android:id="@+id/randomRadio"
                                android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="match_parent" android:minWidth="0dp"
                                android:padding="0dp" android:gravity="center_vertical"
                                android:buttonTint="#347657" android:text="猜先"
                                android:textColor="#214D3A" android:textSize="12sp"/>
                            <RadioButton android:id="@+id/blackRadio"
                                android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="match_parent" android:minWidth="0dp"
                                android:padding="0dp" android:gravity="center_vertical"
                                android:buttonTint="#347657" android:text="执黑"
                                android:textColor="#214D3A" android:textSize="12sp"/>
                            <RadioButton android:id="@+id/whiteRadio"
                                android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="match_parent" android:minWidth="0dp"
                                android:padding="0dp" android:gravity="center_vertical"
                                android:buttonTint="#347657" android:text="执白"
                                android:textColor="#214D3A" android:textSize="12sp"/>
                        </RadioGroup>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
            android:background="#E6DFC9"/>
                    <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="59dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="12dp" android:paddingEnd="12dp">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="对局条件" android:textColor="#385743"
                    android:textSize="13sp"/>
                <FrameLayout
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1">
                    <Spinner android:id="@+id/conditionSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/jade_dialog_field"
                        android:paddingStart="12dp" android:paddingEnd="29dp"
                        android:spinnerMode="dropdown"/>
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="match_parent" android:layout_gravity="end"
                        android:gravity="center" android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no" android:text="⌄"
                        android:textColor="#3C7259" android:textSize="21sp"/>
                </FrameLayout>
            </LinearLayout>
            
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="33dp"
             android:orientation="horizontal" android:gravity="center_vertical"
             android:layout_marginTop="12dp" android:paddingStart="5dp">
             <View android:layout_width="3dp" android:layout_height="15dp"
                 android:background="#B39A62"/>
             <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                 android:layout_marginStart="8dp" android:text="AI 棋手"
                 android:textStyle="bold" android:textSize="14sp" android:textColor="#28543F"/>
             <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                 android:layout_weight="1" android:gravity="end"
                 android:paddingEnd="5dp" android:text="离线模型 · 设备加速"
                 android:textSize="10sp" android:textColor="#748575"/>
          </LinearLayout>
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:background="@drawable/jade_dialog_card">
                    <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="59dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="12dp" android:paddingEnd="12dp">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="运行后端" android:textColor="#385743"
                    android:textSize="13sp"/>
                <FrameLayout
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1">
                    <Spinner android:id="@+id/backendSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/jade_dialog_field"
                        android:paddingStart="12dp" android:paddingEnd="29dp"
                        android:spinnerMode="dropdown"/>
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="match_parent" android:layout_gravity="end"
                        android:gravity="center" android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no" android:text="⌄"
                        android:textColor="#3C7259" android:textSize="21sp"/>
                </FrameLayout>
            </LinearLayout>
            
                    <TextView android:id="@+id/hardwareInfoText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="46dp" android:paddingStart="13dp"
                        android:paddingEnd="13dp" android:paddingBottom="9dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#68816C" android:textSize="10sp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
            android:background="#E6DFC9"/>
                    <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="59dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="12dp" android:paddingEnd="12dp">
                <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                    android:text="棋力等级" android:textColor="#385743"
                    android:textSize="13sp"/>
                <FrameLayout
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1">
                    <Spinner android:id="@+id/difficultySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/jade_dialog_field"
                        android:paddingStart="12dp" android:paddingEnd="29dp"
                        android:spinnerMode="dropdown"/>
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="match_parent" android:layout_gravity="end"
                        android:gravity="center" android:layout_marginEnd="12dp"
                        android:importantForAccessibility="no" android:text="⌄"
                        android:textColor="#3C7259" android:textSize="21sp"/>
                </FrameLayout>
            </LinearLayout>
            
                </LinearLayout>
                <TextView android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="棋力由 Human SL 决定 · 运行后端可切换"
                    android:textColor="#738371" android:textSize="10sp"/>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="86dp"
            android:gravity="center" android:orientation="vertical"
            android:paddingStart="23dp" android:paddingEnd="23dp"
            android:background="@drawable/jade_dialog_footer">
            <Button android:id="@+id/startGameButton"
                android:layout_width="match_parent" android:layout_height="51dp"
                android:background="@drawable/jade_dialog_launch"
                android:text="开始对局  ›" android:textAllCaps="false"
                android:textColor="#FFF2CD" android:textSize="17sp"
                android:textStyle="bold" android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>
    <Button android:id="@+id/closeDialogButton"
        android:layout_width="42dp" android:layout_height="42dp"
        android:layout_gravity="top|end" android:layout_marginEnd="7dp"
        android:layout_marginTop="8dp" android:minWidth="0dp"
        android:minHeight="0dp" android:padding="0dp"
        android:background="@android:color/transparent"
        android:text="×" android:textAllCaps="false"
        android:contentDescription="关闭新对局设置"
        android:textColor="#F2DBA4" android:textSize="27sp"/>
</FrameLayout>
