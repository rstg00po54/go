<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/txwq_popup_bg"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="新开一局"
            android:textColor="#9C6853"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/txwq_dialog_box"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="wrap_content"
                    android:text="棋盘路数"
                    android:textColor="#286B48"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/sizeSpinner"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#B9D9C2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="wrap_content"
                    android:text="执棋颜色"
                    android:textColor="#286B48"
                    android:textSize="14sp" />

                <RadioGroup
                    android:id="@+id/colorGroup"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/randomRadio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minWidth="0dp" android:buttonTint="#5B9D72" android:gravity="center_vertical" android:padding="0dp" android:text="猜先" android:textColor="#286B48" android:textSize="14sp" />
                    <RadioButton android:id="@+id/blackRadio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minWidth="0dp" android:buttonTint="#5B9D72" android:gravity="center_vertical" android:padding="0dp" android:text="执黑" android:textColor="#286B48" android:textSize="14sp" />
                    <RadioButton android:id="@+id/whiteRadio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minWidth="0dp" android:buttonTint="#5B9D72" android:gravity="center_vertical" android:padding="0dp" android:text="执白" android:textColor="#286B48" android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#B9D9C2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="wrap_content"
                    android:text="对局条件"
                    android:textColor="#286B48"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/conditionSpinner"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#B9D9C2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="wrap_content"
                    android:text="AI 运行"
                    android:textColor="#286B48"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/backendSpinner"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#B9D9C2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="wrap_content"
                    android:text="棋力等级"
                    android:textColor="#286B48"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/difficultySpinner"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:spinnerMode="dropdown" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/startGameButton"
            android:layout_width="190dp"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/txwq_green_button"
            android:text="开始对局"
            android:textAllCaps="false"
            android:textColor="#FFF3D0"
            android:textSize="17sp" />
    </LinearLayout>

    <Button
        android:id="@+id/closeDialogButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:background="@android:color/transparent"
        android:text="✕"
        android:textAllCaps="false"
        android:textColor="#57936E"
        android:textSize="23sp" />
</FrameLayout>
