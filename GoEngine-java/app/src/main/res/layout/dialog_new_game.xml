<?xml version="1.0" encoding="utf-8"?>
<!-- v3: true design-based page, not a restyled legacy form. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/jadeNewGameRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#08261D">
    <ImageView android:id="@+id/newGameBackdrop"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/jade_forest_scrim"
        android:importantForAccessibility="no"/>

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical">

        <!-- Gold-edged title plaque, separate back and configuration controls. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="76dp"
            android:paddingStart="9dp" android:paddingEnd="9dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/closeDialogButton"
                android:layout_width="47dp" android:layout_height="47dp"
                android:gravity="center"
                android:background="@drawable/jade_dark_action"
                android:contentDescription="返回" android:src="@drawable/ic_back" android:scaleType="fitCenter" android:padding="4dp" />
            <TextView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="57dp" android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp" android:background="@drawable/jade_dark_title"
                android:gravity="center" android:fontFamily="serif"
                android:text="新建对局" android:textStyle="bold"
                android:textColor="#143B2C" android:textSize="25sp"/>
            <ImageView android:id="@+id/dialogSettingsButton"
                android:layout_width="47dp" android:layout_height="47dp"
                android:gravity="center"
                android:background="@drawable/jade_dark_action"
                android:contentDescription="AI 后端设置" android:src="@drawable/ic_settings_round" android:scaleType="fitCenter" android:padding="4dp" />
        </LinearLayout>

        <ScrollView android:id="@+id/newGameSettingsScroll"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:fillViewport="false"
            android:clipToPadding="false" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="10dp"
                android:paddingEnd="10dp" android:paddingBottom="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="31dp"
    android:layout_marginTop="7dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="match_parent"
        android:gravity="center_vertical" android:id="@+id/jadeSectionBoardSize" android:text="棋盘大小" android:drawableStart="@drawable/ic_board_size" android:drawablePadding="8dp"
        android:textColor="#F2DCA0" android:textStyle="bold" android:textSize="15sp"/>
    
</LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/jade_dark_card" android:orientation="horizontal"
                    android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingTop="7dp"
                    android:paddingBottom="7dp" android:gravity="center_vertical">
                    <com.badukai.ui.JadeBoardSizeView
    android:id="@+id/boardTile9"
    android:layout_width="0dp" android:layout_height="103dp"
    android:layout_weight="1" android:layout_margin="1dp"/>
<com.badukai.ui.JadeBoardSizeView
    android:id="@+id/boardTile11"
    android:layout_width="0dp" android:layout_height="103dp"
    android:layout_weight="1" android:layout_margin="1dp"/>
<com.badukai.ui.JadeBoardSizeView
    android:id="@+id/boardTile13"
    android:layout_width="0dp" android:layout_height="103dp"
    android:layout_weight="1" android:layout_margin="1dp"/>
<com.badukai.ui.JadeBoardSizeView
    android:id="@+id/boardTile15"
    android:layout_width="0dp" android:layout_height="103dp"
    android:layout_weight="1" android:layout_margin="1dp"/>
<com.badukai.ui.JadeBoardSizeView
    android:id="@+id/boardTile19"
    android:layout_width="0dp" android:layout_height="103dp"
    android:layout_weight="1" android:layout_margin="1dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="31dp"
    android:layout_marginTop="7dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="match_parent"
        android:gravity="center_vertical" android:id="@+id/jadeSectionMode" android:text="对弈模式" android:drawableStart="@drawable/ic_player" android:drawablePadding="8dp"
        android:textColor="#F2DCA0" android:textStyle="bold" android:textSize="15sp"/>
    
</LinearLayout>
                <RadioGroup android:id="@+id/modeGroup"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="3dp"
                    android:background="@drawable/jade_dark_card">
                    <RadioButton android:id="@+id/modeAiButton"
    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
    android:layout_margin="3dp" android:button="@null"
    android:background="@drawable/jade_dark_choice"
    android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp"
    android:text="人机对弈" android:drawableTop="@drawable/ic_mode_ai" android:drawablePadding="4dp" android:textSize="13sp" android:textColor="#F5F1DB"
    android:textStyle="bold" android:minWidth="0dp"
    android:enabled="true" android:stateListAnimator="@null"/>
                    <RadioButton android:id="@+id/modeLocalButton"
    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
    android:layout_margin="3dp" android:button="@null"
    android:background="@drawable/jade_dark_choice"
    android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp"
    android:text="人人对弈" android:drawableTop="@drawable/ic_mode_human" android:drawablePadding="4dp" android:textSize="13sp" android:textColor="#F5F1DB"
    android:textStyle="bold" android:minWidth="0dp"
    android:enabled="false" android:stateListAnimator="@null"/>
                    <RadioButton android:id="@+id/modeReplayButton"
    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
    android:layout_margin="3dp" android:button="@null"
    android:background="@drawable/jade_dark_choice"
    android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp"
    android:text="载入棋谱" android:drawableTop="@drawable/ic_import_sgf" android:drawablePadding="4dp" android:textSize="13sp" android:textColor="#F5F1DB"
    android:textStyle="bold" android:minWidth="0dp"
    android:enabled="true" android:stateListAnimator="@null"/>
                </RadioGroup>

                <LinearLayout android:layout_width="match_parent" android:layout_height="31dp"
    android:layout_marginTop="7dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="match_parent"
        android:gravity="center_vertical" android:id="@+id/jadeSectionRank" android:text="AI 等级" android:drawableStart="@drawable/ic_ai_level" android:drawablePadding="8dp"
        android:textColor="#F2DCA0" android:textStyle="bold" android:textSize="15sp"/>
    
</LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="9dp"
                    android:background="@drawable/jade_dark_card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="29dp"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Human SL · 模拟人类棋力"
                            android:textColor="#C9D9C2" android:textSize="11sp"/>
                        <TextView android:id="@+id/aiRankValueText"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="12级" android:textStyle="bold"
                            android:textColor="#F4D27A" android:textSize="20sp"/>
                    </LinearLayout>
                    <SeekBar android:id="@+id/rankSeekBar"
                        android:layout_width="match_parent" android:layout_height="36dp"
                        android:max="17" android:progress="11"
                        android:progressDrawable="@drawable/jade_dark_slider"
                        android:thumb="@drawable/jade_slider_thumb"
                        android:splitTrack="false"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="1级" android:gravity="start"
                            android:textColor="#CED4C7" android:textSize="10sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="5级" android:gravity="center"
                            android:textColor="#CED4C7" android:textSize="10sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="10级" android:gravity="center"
                            android:textColor="#CED4C7" android:textSize="10sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="14级" android:gravity="center"
                            android:textColor="#CED4C7" android:textSize="10sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="18级" android:gravity="end"
                            android:textColor="#CED4C7" android:textSize="10sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="31dp"
    android:layout_marginTop="7dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="match_parent"
        android:gravity="center_vertical" android:id="@+id/jadeSectionColor" android:text="执子方" android:drawableStart="@drawable/ic_turn" android:drawablePadding="8dp"
        android:textColor="#F2DCA0" android:textStyle="bold" android:textSize="15sp"/>
    
</LinearLayout>
                <RadioGroup android:id="@+id/colorGroup"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="3dp"
                    android:background="@drawable/jade_dark_card">
                    <RadioButton android:id="@+id/blackRadio"
    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
    android:layout_margin="3dp" android:button="@null"
    android:background="@drawable/jade_dark_choice"
    android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp"
    android:text="黑先" android:drawableTop="@drawable/ic_black_stone" android:drawablePadding="4dp" android:textSize="13sp" android:textColor="#F5F1DB"
    android:textStyle="bold" android:minWidth="0dp"
    android:enabled="true" android:stateListAnimator="@null"/>
                    <RadioButton android:id="@+id/whiteRadio"
    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
    android:layout_margin="3dp" android:button="@null"
    android:background="@drawable/jade_dark_choice"
    android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp"
    android:text="白先" android:drawableTop="@drawable/ic_white_stone" android:drawablePadding="4dp" android:textSize="13sp" android:textColor="#F5F1DB"
    android:textStyle="bold" android:minWidth="0dp"
    android:enabled="true" android:stateListAnimator="@null"/>
                    <RadioButton android:id="@+id/randomRadio"
    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
    android:layout_margin="3dp" android:button="@null"
    android:background="@drawable/jade_dark_choice"
    android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp"
    android:text="随机" android:drawableTop="@drawable/ic_random" android:drawablePadding="4dp" android:textSize="13sp" android:textColor="#F5F1DB"
    android:textStyle="bold" android:minWidth="0dp"
    android:enabled="true" android:stateListAnimator="@null"/>
                </RadioGroup>

                <LinearLayout android:layout_width="match_parent" android:layout_height="31dp"
    android:layout_marginTop="7dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="match_parent"
        android:gravity="center_vertical" android:id="@+id/jadeSectionBackend" android:text="AI 推理后端" android:drawableStart="@drawable/ic_backend" android:drawablePadding="8dp"
        android:textColor="#F2DCA0" android:textStyle="bold" android:textSize="15sp"/>
    
</LinearLayout>
                <LinearLayout android:id="@+id/aiBackendSection"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="7dp" android:orientation="vertical"
                    android:background="@drawable/jade_dark_card">
                    <RadioGroup android:id="@+id/backendGroup"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton android:id="@+id/backendCpuButton"
    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
    android:layout_margin="3dp" android:button="@null"
    android:background="@drawable/jade_dark_choice"
    android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp"
    android:text="CPU" android:drawableTop="@drawable/ic_cpu" android:drawablePadding="4dp" android:textSize="13sp" android:textColor="#F5F1DB"
    android:textStyle="bold" android:minWidth="0dp"
    android:enabled="true" android:stateListAnimator="@null"/>
                        <RadioButton android:id="@+id/backendGpuButton"
    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
    android:layout_margin="3dp" android:button="@null"
    android:background="@drawable/jade_dark_choice"
    android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp"
    android:text="GPU" android:drawableTop="@drawable/ic_gpu" android:drawablePadding="4dp" android:textSize="13sp" android:textColor="#F5F1DB"
    android:textStyle="bold" android:minWidth="0dp"
    android:enabled="true" android:stateListAnimator="@null"/>
                        <RadioButton android:id="@+id/backendNpuButton"
    android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1"
    android:layout_margin="3dp" android:button="@null"
    android:background="@drawable/jade_dark_choice"
    android:gravity="center" android:paddingStart="2dp" android:paddingEnd="2dp"
    android:text="NPU" android:drawableTop="@drawable/ic_npu" android:drawablePadding="4dp" android:textSize="13sp" android:textColor="#F5F1DB"
    android:textStyle="bold" android:minWidth="0dp"
    android:enabled="true" android:stateListAnimator="@null"/>
                    </RadioGroup>
                    <TextView android:id="@+id/modelInfoText"
                        android:layout_width="match_parent" android:layout_height="36dp"
                        android:layout_marginTop="4dp" android:gravity="center_vertical"
                        android:background="@drawable/jade_dark_outline"
                        android:paddingStart="11dp"
                        android:text="模型     Human SL b18（人类棋力）"
                        android:textColor="#EEEAD7" android:textSize="12sp"/>
                    <TextView android:id="@+id/deviceModelText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:singleLine="true"
                        android:ellipsize="end" android:textSize="10sp"
                        android:textColor="#C2CFBB"/>
                    <TextView android:id="@+id/hardwareInfoText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="3" android:ellipsize="end"
                        android:textSize="10sp" android:textColor="#A6C0AD"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="31dp"
    android:layout_marginTop="7dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="match_parent"
        android:gravity="center_vertical" android:id="@+id/jadeSectionRules" android:text="对局条件" android:drawableStart="@drawable/ic_turn" android:drawablePadding="8dp"
        android:textColor="#F2DCA0" android:textStyle="bold" android:textSize="15sp"/>
    
</LinearLayout>
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="51dp" android:background="@drawable/jade_dark_card"
                    android:paddingStart="12dp" android:paddingEnd="10dp"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="85dp" android:layout_height="wrap_content"
                        android:text="分先 / 让子" android:textColor="#E4E2CE"
                        android:textSize="12sp"/>
                    <Spinner android:id="@+id/conditionSpinner"
                        android:layout_width="0dp" android:layout_height="38dp"
                        android:layout_weight="1" android:background="@drawable/jade_dark_outline"
                        android:paddingStart="9dp" android:spinnerMode="dropdown"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <FrameLayout android:layout_width="match_parent" android:layout_height="76dp"
            android:paddingStart="19dp" android:paddingEnd="19dp"
            android:paddingTop="8dp" android:paddingBottom="7dp"
            android:background="@drawable/jade_dark_footer">
            <Button android:id="@+id/startGameButton"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/jade_dark_action"
                android:text="开 始 对 局" android:textStyle="bold"
                android:textColor="#F4EACF" android:textSize="21sp"
                android:fontFamily="serif" android:textAllCaps="false"
                android:stateListAnimator="@null"/>
        </FrameLayout>
        <com.badukai.ui.JadeBottomNavView android:id="@+id/newGameSharedNav"
            android:layout_width="match_parent" android:layout_height="70dp"
            android:layout_marginStart="9dp" android:layout_marginEnd="9dp"
            android:layout_marginBottom="3dp"/>
    </LinearLayout>
</FrameLayout>