<?xml version="1.0" encoding="utf-8"?>
<!-- Real KataGo analysis. The full-page content scrolls; bottom navigation stays fixed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#061D17">
    <ImageView android:id="@+id/analysisBackdrop"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:importantForAccessibility="no"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/jade_forest_scrim" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="53dp"
            android:paddingStart="9dp" android:paddingEnd="9dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/analysisBack"
                android:layout_width="44dp" android:layout_height="44dp"
                android:background="@drawable/btn_round_back"
                android:contentDescription="返回棋谱"/>
            <TextView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="46dp" android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp" android:gravity="center"
                android:background="@drawable/jade_button_bg"
                android:text="AI 分 析" android:textSize="22sp"
                android:textColor="#123B2C" android:textStyle="bold"
                android:fontFamily="serif"/>
            <!-- Mirror the Back button so the title stays optically centered. -->
            <View android:layout_width="44dp" android:layout_height="1dp"
                android:importantForAccessibility="no"/>
        </LinearLayout>
        <ScrollView android:id="@+id/analysisContentScroll"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:scrollbars="none" android:fillViewport="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="7dp">
                <!-- Full-width analysis summary above the square Go board. -->
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:background="@drawable/jade_dark_card"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="3dp" android:paddingBottom="3dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="45dp" android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:orientation="vertical">
                            <LinearLayout android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:id="@+id/analysisWinTitle"
                                    android:layout_width="0dp" android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:singleLine="true" android:ellipsize="end"
                                    android:text="黑方胜率" android:textColor="#DDE5D4"
                                    android:textSize="11sp"/>
                                <TextView android:id="@+id/analysisHumanSide"
                                    android:layout_width="43dp" android:layout_height="23dp"
                                    android:layout_marginStart="3dp"
                                    android:background="@drawable/jade_dark_action"
                                    android:gravity="center" android:text="执子?"
                                    android:textColor="#F4D991" android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:contentDescription="选择本局自己执黑还是执白"/>
                            </LinearLayout>
                            <TextView android:id="@+id/analysisBlackWin"
                                android:layout_width="match_parent" android:layout_height="26dp"
                                android:gravity="center_vertical" android:text="--"
                                android:textColor="#F3D88C" android:textSize="20sp"
                                android:textStyle="bold"/>
                            <ProgressBar android:id="@+id/analysisWinProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent" android:layout_height="5dp"
                                android:max="1000" android:progress="0"
                                android:progressTint="#24D6A0"
                                android:progressBackgroundTint="#456C60"/>
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="35dp"
                            android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
                            android:background="#607B6955"/>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:orientation="vertical">
                            <TextView android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="预计目数差" android:textColor="#DDE5D4"
                                android:textSize="12sp"/>
                            <TextView android:id="@+id/analysisLead"
                                android:layout_width="match_parent" android:layout_height="28dp"
                                android:gravity="center_vertical" android:text="待分析"
                                android:textColor="#F3D88C" android:textSize="19sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginTop="3dp" android:layout_marginBottom="3dp"
                        android:background="#587B6955"/>
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:id="@+id/analysisCaptures"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:lineSpacingExtra="1dp"
                            android:text="黑方估空 -- · 白方估空 --\n黑棋提子 -- · 白棋提子 --"
                            android:textColor="#D4E0D2" android:textSize="11sp"/>
                        <View android:layout_width="1dp" android:layout_height="25dp"
                            android:layout_marginStart="8dp" android:layout_marginEnd="10dp"
                            android:background="#587B6955"/>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1.2"
                            android:layout_height="wrap_content" android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView android:id="@+id/analysisBoardMeta"
                                android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="wrap_content" android:maxLines="2"
                                android:ellipsize="end" android:gravity="center_vertical"
                                android:lineSpacingExtra="1dp"
                                android:text="9×9 · 贴5.5"
                                android:textColor="#F0D68D" android:textSize="11sp"/>
                            <TextView android:id="@+id/analysisExport"
                                android:layout_width="31dp" android:layout_height="27dp"
                                android:layout_marginStart="3dp"
                                android:background="@drawable/jade_dark_action"
                                android:gravity="center" android:text="导出"
                                android:textColor="#F4D991" android:textSize="10sp"
                                android:contentDescription="导出当前棋谱为 SGF"/>
                            <TextView android:id="@+id/analysisShare"
                                android:layout_width="31dp" android:layout_height="27dp"
                                android:layout_marginStart="3dp"
                                android:background="@drawable/jade_dark_action"
                                android:gravity="center" android:text="分享"
                                android:textColor="#F4D991" android:textSize="10sp"
                                android:contentDescription="分享当前棋谱"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <com.badukai.ui.JadeSquareBoardFrame android:id="@+id/analysisBoardFrame"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:padding="4dp"
                    android:background="@drawable/jade_game_wood_panel">
                    <com.badukai.ui.GoBoardView android:id="@+id/analysisBoard"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:contentDescription="分析当前棋盘与候选落点"/>
                </com.badukai.ui.JadeSquareBoardFrame>
                <TextView android:id="@+id/analysisStatus"
                    android:layout_width="match_parent" android:layout_height="18dp"
                    android:layout_marginTop="1dp" android:layout_marginBottom="1dp"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:singleLine="true" android:ellipsize="end"
                    android:text="选择棋谱后开始分析" android:textColor="#D3E3CE"
                    android:textSize="12sp" android:gravity="center"/>
                <!-- Single compact switcher: chart and moves never stack vertically. -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="31dp"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:layout_marginTop="1dp" android:layout_marginBottom="2dp"
                    android:padding="2dp" android:orientation="horizontal"
                    android:background="@drawable/jade_dark_card">
                    <Button android:id="@+id/analysisTrendTab"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="match_parent" android:minWidth="0dp"
                        android:minHeight="0dp" android:text="胜率走势"
                        android:textAllCaps="false" android:textSize="14sp"
                        android:textColor="#D3D5C2" android:background="@drawable/jade_dark_card"/>
                    <Button android:id="@+id/analysisMovesTab"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="match_parent" android:minWidth="0dp"
                        android:minHeight="0dp" android:text="推荐着法"
                        android:textAllCaps="false" android:textSize="14sp"
                        android:textColor="#F5E5BC" android:background="@drawable/jade_dark_action"/>
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent"
                    android:layout_height="87dp"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp">
                    <LinearLayout android:id="@+id/analysisTrendPanel"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:padding="4dp"
                        android:background="@drawable/jade_dark_card"
                        android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="27dp"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <Switch android:id="@+id/analysisFromStep"
                                android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="27dp"
                                android:text="从本手开始" android:textSize="11sp"
                                android:textColor="#DBE5D2" android:showText="false"
                                android:checked="false" android:gravity="center_vertical"/>
                            <Button android:id="@+id/analysisFullButton"
                                android:layout_width="90dp" android:layout_height="26dp"
                                android:minWidth="0dp" android:minHeight="0dp"
                                android:text="分析全局" android:textAllCaps="false"
                                android:textSize="11sp" android:textColor="#F3E2BD"
                                android:background="@drawable/jade_dark_action"/>
                        </LinearLayout>
                        <com.badukai.ui.JadeAnalysisChartView android:id="@+id/analysisChart"
                            android:layout_width="match_parent" android:layout_height="52dp"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/analysisMovesPanel"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:padding="3dp"
                        android:background="@drawable/jade_dark_card">
                        <LinearLayout android:id="@+id/analysisCandidateList"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:orientation="vertical"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </ScrollView>
        <!-- In-page move navigation: no need to return to ReplayActivity. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
            android:orientation="vertical" android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp" android:paddingBottom="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <Button android:id="@+id/analysisPrevious"
                    android:layout_width="65dp" android:layout_height="30dp"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:background="@drawable/jade_game_white_button"
                    android:text="◀ 上一手" android:textSize="11sp" android:textAllCaps="false"
                    android:textColor="#184A39"/>
                <SeekBar android:id="@+id/analysisMoveSeek"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="30dp" android:max="0" android:progress="0"
                    android:progressTint="#29D7AC" android:thumbTint="#F5D58A"/>
                <Button android:id="@+id/analysisNext"
                    android:layout_width="65dp" android:layout_height="30dp"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:background="@drawable/jade_game_white_button"
                    android:text="下一手 ▶" android:textSize="11sp" android:textAllCaps="false"
                    android:textColor="#184A39"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="31dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/analysisMoveLabel"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="match_parent" android:gravity="center_vertical"
                    android:text="第 0/0 手" android:textColor="#F1D58D"
                    android:textSize="12sp"/>
                <Button android:id="@+id/analysisPlay"
                    android:layout_width="97dp" android:layout_height="29dp"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:background="@drawable/jade_game_white_button"
                    android:text="▶ 自动播放" android:textSize="11sp" android:textAllCaps="false"
                    android:textColor="#184A39"/>
                <Button android:id="@+id/analysisCurrent"
                    android:layout_width="75dp" android:layout_height="29dp"
                    android:layout_marginStart="5dp"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:background="@drawable/jade_game_white_button"
                    android:text="返回本手" android:textSize="11sp" android:textAllCaps="false"
                    android:textColor="#184A39"/>
            </LinearLayout>
        </LinearLayout>
        <com.badukai.ui.JadeBottomNavView android:id="@+id/analysisSharedNav"
            android:layout_width="match_parent" android:layout_height="96dp"
            android:layout_marginStart="9dp" android:layout_marginEnd="9dp"
            android:layout_marginBottom="0dp"/>
    </LinearLayout>
</FrameLayout>
