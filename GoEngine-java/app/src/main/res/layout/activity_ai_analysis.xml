<?xml version="1.0" encoding="utf-8"?>
<!-- Real KataGo analysis. The full-page content scrolls; bottom navigation stays fixed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#061D17">
    <ImageView android:id="@+id/analysisBackdrop"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:importantForAccessibility="no"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/jade_forest_scrim" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="62dp"
            android:paddingStart="9dp" android:paddingEnd="9dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/analysisBack"
                android:layout_width="44dp" android:layout_height="44dp"
                android:background="@drawable/btn_round_back"
                android:contentDescription="返回棋谱"/>
            <TextView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="53dp" android:layout_marginStart="10dp"
                android:layout_marginEnd="54dp" android:gravity="center"
                android:background="@drawable/jade_button_bg"
                android:text="AI 分 析" android:textSize="24sp"
                android:textColor="#123B2C" android:textStyle="bold"
                android:fontFamily="serif"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="45dp"
            android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
            android:layout_marginBottom="5dp" android:padding="3dp"
            android:background="@drawable/jade_dark_card" android:orientation="horizontal">
            <Button android:id="@+id/analysisQuickTab"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp"
                android:background="@drawable/jade_dark_action"
                android:text="快速分析" android:textColor="#F5E5BC"
                android:textSize="15sp" android:textAllCaps="false"/>
            <Button android:id="@+id/analysisVariationTab"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:minWidth="0dp" android:minHeight="0dp"
                android:background="@drawable/jade_dark_card"
                android:text="变化图" android:textColor="#D3D5C2"
                android:textSize="15sp" android:textAllCaps="false"/>
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:scrollbars="none" android:fillViewport="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="10dp"
                android:paddingEnd="10dp" android:paddingBottom="7dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="top">
                    <com.badukai.ui.JadeSquareBoardFrame android:id="@+id/analysisBoardFrame"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:padding="5dp"
                        android:background="@drawable/jade_game_wood_panel">
                        <com.badukai.ui.GoBoardView android:id="@+id/analysisBoard"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:contentDescription="分析当前棋盘与候选落点"/>
                    </com.badukai.ui.JadeSquareBoardFrame>
                    <LinearLayout android:layout_width="106dp" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:orientation="vertical"
                        android:padding="7dp" android:background="@drawable/jade_dark_card">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="黑方胜率" android:textColor="#DDE5D4" android:textSize="12sp"/>
                        <TextView android:id="@+id/analysisBlackWin"
                            android:layout_width="match_parent" android:layout_height="40dp"
                            android:gravity="center_vertical" android:text="--"
                            android:textColor="#F3D88C" android:textSize="24sp" android:textStyle="bold"/>
                        <ProgressBar android:id="@+id/analysisWinProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent" android:layout_height="5dp"
                            android:max="1000" android:progress="0"
                            android:progressTint="#24D6A0" android:progressBackgroundTint="#456C60"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="11dp"
                            android:text="预计目数差" android:textColor="#DDE5D4" android:textSize="12sp"/>
                        <TextView android:id="@+id/analysisLead"
                            android:layout_width="match_parent" android:layout_height="39dp"
                            android:gravity="center_vertical" android:text="待分析"
                            android:textColor="#F3D88C" android:textSize="18sp" android:textStyle="bold"/>
                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="#587B6955"/>
                        <TextView android:id="@+id/analysisCaptures"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:lineSpacingExtra="4dp"
                            android:text="黑棋提子 --\n白棋提子 --"
                            android:textColor="#D4E0D2" android:textSize="11sp"/>
                        <TextView android:id="@+id/analysisBoardMeta"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="11dp" android:text="-- 路"
                            android:textColor="#F0D68D" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/analysisStatus"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:layout_marginBottom="5dp"
                    android:text="选择棋谱后开始分析" android:textColor="#D3E3CE"
                    android:textSize="12sp" android:gravity="center"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="8dp"
                    android:background="@drawable/jade_dark_card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:gravity="center_vertical"
                            android:text="胜率走势" android:textColor="#F3D68B"
                            android:textSize="16sp" android:textStyle="bold"/>
                        <Button android:id="@+id/analysisFullButton"
                            android:layout_width="103dp" android:layout_height="34dp"
                            android:minWidth="0dp" android:minHeight="0dp"
                            android:text="分析全局" android:textAllCaps="false"
                            android:textSize="12sp" android:textColor="#F3E2BD"
                            android:background="@drawable/jade_dark_action"/>
                    </LinearLayout>
                    <com.badukai.ui.JadeAnalysisChartView android:id="@+id/analysisChart"
                        android:layout_width="match_parent" android:layout_height="125dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="7dp" android:padding="7dp"
                    android:orientation="vertical" android:background="@drawable/jade_dark_card">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="match_parent" android:gravity="center_vertical"
                            android:text="推荐着法" android:textColor="#F3D68B"
                            android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="黑方胜率 / 预计领先" android:textSize="10sp"
                            android:textColor="#C5D6C7"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/analysisCandidateList"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/analysisPrevious"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="39dp"
                android:layout_marginEnd="3dp" android:minWidth="0dp" android:minHeight="0dp"
                android:background="@drawable/jade_game_white_button" android:text="▶ 播放"
                android:textAllCaps="false" android:textSize="12sp" android:textColor="#184A39"/>
            <Button android:id="@+id/analysisPlay"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="39dp"
                android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
                android:minWidth="0dp" android:minHeight="0dp"
                android:background="@drawable/jade_game_white_button" android:text="▶▶ 自动播放"
                android:textAllCaps="false" android:textSize="11sp" android:textColor="#184A39"/>
            <Button android:id="@+id/analysisCurrent"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="39dp"
                android:layout_marginStart="3dp" android:minWidth="0dp" android:minHeight="0dp"
                android:background="@drawable/jade_game_white_button" android:text="↶ 切换到本手"
                android:textAllCaps="false" android:textSize="12sp" android:textColor="#184A39"/>
        </LinearLayout>
        <com.badukai.ui.JadeBottomNavView android:id="@+id/analysisSharedNav"
            android:layout_width="match_parent" android:layout_height="96dp"
            android:layout_marginStart="9dp" android:layout_marginEnd="9dp"
            android:layout_marginBottom="0dp"/>
    </LinearLayout>
</FrameLayout>
