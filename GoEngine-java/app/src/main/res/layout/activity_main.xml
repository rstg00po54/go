<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.badukai.ui.GoHomeTouchLayout
        android:id="@+id/mainPageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#193424">
        <ImageView
            android:id="@+id/homeArtwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            android:contentDescription="竹林书房与围棋雅室" />
        <View android:id="@+id/homeTopShade"
            android:layout_width="1dp" android:layout_height="1dp"
            android:importantForAccessibility="no"
            android:background="@drawable/jade_home_scrim"/>
        <TextView android:id="@+id/homeTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="竹隐 · 围棋" android:textColor="#FFF4D8"
            android:textSize="29sp" android:textStyle="bold"
            android:shadowColor="#99000000" android:shadowRadius="5"
            android:shadowDx="1" android:shadowDy="2"/>
        <TextView android:id="@+id/homeSubtitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="一局一境 · 棋落竹影" android:textColor="#F5DFAD"
            android:textSize="15sp" android:shadowColor="#BB000000"
            android:shadowRadius="3"/>
        <TextView android:id="@+id/homeLocalBadge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/jade_home_badge"
            android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:singleLine="true" android:text="本地 KataGo · 离线对弈"
            android:textColor="#254D3A" android:textSize="12sp"/>
        <Button android:id="@+id/aiBattleButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="人机对弈"
            android:padding="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/homeRecordButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="棋谱复盘"
            android:padding="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/homeTrainingButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="死活训练"
            android:padding="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/homeSettingsButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="设置"
            android:padding="0dp" android:stateListAnimator="@null" />
        <ImageView android:id="@+id/homeNavBarArtwork"
            android:layout_width="1dp" android:layout_height="1dp"
            android:scaleType="fitCenter" android:importantForAccessibility="no"
            android:contentDescription="翡翠底部导航栏" />
        <Button android:id="@+id/homeTabButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="首页"
            android:padding="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/homeGameTabButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="对弈"
            android:padding="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/homeRecordTabButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="棋谱"
            android:padding="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/homeTrainingTabButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="训练"
            android:padding="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/homeSettingsTabButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="设置"
            android:padding="0dp" android:stateListAnimator="@null" />
    </com.badukai.ui.GoHomeTouchLayout>


    <!-- Jade game screen v1: artwork supplies decoration; actual GoBoardView remains interactive. -->
    <FrameLayout android:id="@+id/gamePageContainer"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#051E18" android:visibility="gone">
        <ImageView android:id="@+id/gameBackdrop"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:importantForAccessibility="no"/>
        <View android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/jade_forest_scrim"
            android:importantForAccessibility="no"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:paddingTop="4dp">
            <!-- Jade title plaque -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="61dp"
                android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
                android:orientation="horizontal">
                <Button android:id="@+id/backButton" android:layout_width="44dp"
                    android:layout_height="44dp" android:background="@drawable/btn_round_back"
                    android:text="" android:contentDescription="返回首页" android:stateListAnimator="@null"/>
                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginStart="13dp" android:layout_marginEnd="13dp"
                    android:layout_height="53dp" android:gravity="center"
                    android:background="@drawable/jade_dark_title"
                    android:text="人 机 对 弈" android:textColor="#173C2E"
                    android:textStyle="bold" android:fontFamily="serif" android:textSize="22sp"/>
                <Button android:id="@+id/newGameButton" android:layout_width="44dp"
                    android:layout_height="44dp" android:background="@drawable/btn_round_settings"
                    android:text="" android:contentDescription="新局设置" android:stateListAnimator="@null"/>
            </LinearLayout>
            <!-- Always-updating four-column game facts -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="55dp"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:layout_marginTop="5dp" android:layout_marginBottom="6dp"
                android:background="@drawable/jade_dark_card"
                android:paddingStart="5dp" android:paddingEnd="5dp"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
 android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
 android:paddingStart="3dp" android:paddingEnd="3dp">
 <TextView android:id="@+id/gameTitleText" android:layout_width="match_parent" android:layout_height="26dp"
  android:gravity="center" android:text="9×9" android:textColor="#F4E2B1"
  android:textSize="12sp" android:textStyle="bold" android:maxLines="1"
  android:ellipsize="end" android:drawableStart="@drawable/ic_board_grid_gold" android:drawablePadding="3dp"/>
 </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
 android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
 android:paddingStart="3dp" android:paddingEnd="3dp">
 <TextView android:id="@+id/gameModeSummaryText" android:layout_width="match_parent" android:layout_height="26dp"
  android:gravity="center" android:text="人机对弈" android:textColor="#F4E2B1"
  android:textSize="12sp" android:textStyle="bold" android:maxLines="1"
  android:ellipsize="end" android:drawableStart="@drawable/ic_robot_ivory" android:drawablePadding="3dp"/>
 </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
 android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
 android:paddingStart="3dp" android:paddingEnd="3dp">
 <TextView android:id="@+id/gameRankSummaryText" android:layout_width="match_parent" android:layout_height="26dp"
  android:gravity="center" android:text="12级" android:textColor="#F4E2B1"
  android:textSize="12sp" android:textStyle="bold" android:maxLines="1"
  android:ellipsize="end" android:drawableStart="@drawable/ic_difficulty_gold" android:drawablePadding="3dp"/>
 </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
 android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
 android:paddingStart="3dp" android:paddingEnd="3dp">
 <TextView android:id="@+id/gameBackendSummaryText" android:layout_width="match_parent" android:layout_height="26dp"
  android:gravity="center" android:text="NPU" android:textColor="#F4E2B1"
  android:textSize="12sp" android:textStyle="bold" android:maxLines="1"
  android:ellipsize="end" android:drawableStart="@drawable/ic_npu_ivory" android:drawablePadding="3dp"/>
 </LinearLayout>
            </LinearLayout>
            <!-- Adaptive square board. A lower bar never shrinks the board's touch hitboxes. -->
            <FrameLayout android:id="@+id/boardFrame"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="9dp" android:layout_marginEnd="9dp"
                android:layout_marginBottom="5dp" android:padding="7dp"
                android:background="@drawable/jade_game_wood_panel">
                <com.badukai.ui.GoBoardView android:id="@+id/boardView"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_gravity="center"/>
            </FrameLayout>
            <!-- Real captures, turn, win rate and engine timings; retain original IDs. -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="83dp"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:layout_marginBottom="6dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1.1"
                    android:layout_height="match_parent" android:layout_marginEnd="4dp"
                    android:background="@drawable/jade_dark_card" android:orientation="vertical"
                    android:gravity="center_vertical" android:paddingStart="7dp" android:paddingEnd="7dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="29dp" android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View android:id="@+id/aiStoneView" android:layout_width="21dp"
                            android:layout_height="21dp" android:background="@drawable/txwq_white_stone"/>
                        <TextView android:id="@+id/aiCaptureText" android:layout_width="0dp"
                            android:layout_weight="1" android:layout_height="wrap_content"
                            android:text="白棋提子 0" android:textColor="#FFF0CD" android:textSize="10sp"
                            android:singleLine="true" android:gravity="center"/>
                        <View android:id="@+id/playerStoneView" android:layout_width="21dp"
                            android:layout_height="21dp" android:background="@drawable/txwq_black_stone"/>
                        <TextView android:id="@+id/playerCaptureText" android:layout_width="0dp"
                            android:layout_weight="1" android:layout_height="wrap_content"
                            android:text="黑棋提子 0" android:textColor="#FFF0CD" android:textSize="10sp"
                            android:singleLine="true" android:gravity="center"/>
                    </LinearLayout>
                    <TextView android:id="@+id/gameMoveCountText"
                        android:layout_width="match_parent" android:layout_height="18dp"
                        android:gravity="center" android:text="第 0 手"
                        android:textColor="#F6D47A" android:textStyle="bold" android:textSize="12sp"/>
                    <TextView android:id="@+id/statusText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center" android:maxLines="1" android:ellipsize="end"
                        android:text="正在准备对局" android:textColor="#D3E8D4" android:textSize="10sp"/>
                    <TextView android:id="@+id/nnAreaScoreText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="黑 -- · 白 --" android:textColor="#F6D47A"
                        android:textSize="9sp" android:gravity="center" android:visibility="gone"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="0.9"
                    android:layout_height="match_parent" android:layout_marginStart="4dp"
                    android:background="@drawable/jade_dark_card" android:orientation="vertical"
                    android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
                    <TextView android:id="@+id/playerWinRateText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="黑胜率 --%" android:textColor="#F6D47A"
                        android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/aiWinRateText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="白胜率 --%" android:textColor="#E7EAD7" android:textSize="11sp"/>
                    <ProgressBar android:id="@+id/winRateProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="7dp"
                        android:layout_marginTop="2dp" android:layout_marginBottom="1dp"
                        android:clickable="true" android:max="1000" android:progress="500"
                        android:contentDescription="点击查看真实胜率曲线"
                        android:progressDrawable="@drawable/jade_winrate_progress"/>
                    <TextView android:id="@+id/aiMoveTimeText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="本手用时 --"
                        android:textSize="9sp" android:textColor="#CFDBCB" android:singleLine="true"/>
                </LinearLayout>
            </LinearLayout>
            <!-- Actual controls: pass, undo, territory, AI suggestions and win-rate analysis. -->
            <LinearLayout android:id="@+id/gameActionPanel"
                android:layout_width="match_parent" android:layout_height="116dp"
                android:layout_marginStart="9dp" android:layout_marginEnd="9dp"
                android:orientation="vertical" android:paddingBottom="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:orientation="horizontal">
                    <Button android:id="@+id/passButton"
 android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
 android:layout_margin="3dp" android:minWidth="0dp" android:minHeight="0dp"
 android:paddingStart="2dp" android:paddingEnd="2dp"
 android:text="停一手" android:textAllCaps="false"
 android:textColor="#214E3D" android:textSize="13sp" android:textStyle="bold"
 android:drawableStart="@drawable/ic_pass_jade" android:drawablePadding="1dp"
 android:background="@drawable/jade_game_white_button"
 android:stateListAnimator="@null"/>
                    <Button android:id="@+id/undoButton"
 android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
 android:layout_margin="3dp" android:minWidth="0dp" android:minHeight="0dp"
 android:paddingStart="2dp" android:paddingEnd="2dp"
 android:text="悔棋" android:textAllCaps="false"
 android:textColor="#214E3D" android:textSize="13sp" android:textStyle="bold"
 android:drawableStart="@drawable/ic_undo_jade" android:drawablePadding="1dp"
 android:background="@drawable/jade_game_white_button"
 android:stateListAnimator="@null"/>
                    <Button android:id="@+id/situationButton"
 android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
 android:layout_margin="3dp" android:minWidth="0dp" android:minHeight="0dp"
 android:paddingStart="2dp" android:paddingEnd="2dp"
 android:text="形势" android:textAllCaps="false"
 android:textColor="#214E3D" android:textSize="13sp" android:textStyle="bold"
 android:drawableStart="@drawable/ic_territory_jade" android:drawablePadding="1dp"
 android:background="@drawable/jade_game_white_button"
 android:stateListAnimator="@null"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:orientation="horizontal">
                    <Button android:id="@+id/aiSuggestionButton"
 android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
 android:layout_margin="3dp" android:minWidth="0dp" android:minHeight="0dp"
 android:paddingStart="2dp" android:paddingEnd="2dp"
 android:text="落子提示" android:textAllCaps="false"
 android:textColor="#214E3D" android:textSize="13sp" android:textStyle="bold"
 android:drawableStart="@drawable/ic_hint_gold" android:drawablePadding="1dp"
 android:background="@drawable/jade_game_white_button"
 android:stateListAnimator="@null"/>
                    <Button android:id="@+id/gameAnalysisButton"
 android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
 android:layout_margin="3dp" android:minWidth="0dp" android:minHeight="0dp"
 android:paddingStart="2dp" android:paddingEnd="2dp"
 android:text="AI分析" android:textAllCaps="false"
 android:textColor="#214E3D" android:textSize="13sp" android:textStyle="bold"
 android:drawableStart="@drawable/ic_analysis_jade" android:drawablePadding="1dp"
 android:background="@drawable/jade_game_white_button"
 android:stateListAnimator="@null"/>
                    <Button android:id="@+id/gameMoreButton" android:layout_width="0dp"
                        android:layout_height="48dp" android:layout_weight="0.65"
                        android:layout_margin="3dp" android:minWidth="0dp" android:minHeight="0dp"
                        android:text="更多" android:textAllCaps="false"
                        android:textColor="#EAD49A" android:textSize="12sp"
                        android:background="@drawable/jade_dark_choice"/>
                </LinearLayout>
            </LinearLayout>
            <!-- Real move-history timeline, populated from GoBoard's immutable history snapshot. -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:layout_marginTop="2dp" android:layout_marginBottom="4dp"
                android:background="@drawable/jade_dark_card"
                android:paddingStart="4dp" android:paddingEnd="4dp"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/gameTimelineBack"
                    android:layout_width="35dp" android:layout_height="35dp"
                    android:background="@drawable/btn_round_back" android:contentDescription="向前浏览落子记录"/>
                <HorizontalScrollView android:id="@+id/gameTimelineScroll"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                    android:fillViewport="false" android:scrollbars="none">
                    <LinearLayout android:id="@+id/gameTimelineMoves"
                        android:layout_width="wrap_content" android:layout_height="match_parent"
                        android:orientation="horizontal" android:gravity="center_vertical"/>
                </HorizontalScrollView>
                <ImageButton android:id="@+id/gameTimelineNext"
                    android:layout_width="35dp" android:layout_height="35dp"
                    android:background="@drawable/btn_round_next" android:contentDescription="向后浏览落子记录"/>
            </LinearLayout>
            <!-- Consistent navigation with new-game screen; no baked screenshot hitboxes. -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp"
                android:orientation="horizontal" android:background="@drawable/jade_dark_footer"
                android:paddingStart="4dp" android:paddingEnd="4dp">
                <TextView android:id="@+id/gameNavHome" android:layout_width="0dp"
 android:layout_weight="1" android:layout_height="match_parent" android:gravity="center"
 android:clickable="true" android:focusable="true" android:contentDescription="首页"
 android:background="@android:color/transparent"
 android:drawableTop="@drawable/ic_home_ivory" android:drawablePadding="2dp"
 android:text="首页" android:textColor="#EAF0E4" android:textSize="11sp"/>
                <TextView android:id="@+id/gameNavRecords" android:layout_width="0dp"
 android:layout_weight="1" android:layout_height="match_parent" android:gravity="center"
 android:clickable="true" android:focusable="true" android:contentDescription="棋谱"
 android:background="@android:color/transparent"
 android:drawableTop="@drawable/ic_book_ivory" android:drawablePadding="2dp"
 android:text="棋谱" android:textColor="#EAF0E4" android:textSize="11sp"/>
                <TextView android:id="@+id/gameNavPlay" android:layout_width="0dp"
 android:layout_weight="1" android:layout_height="match_parent" android:gravity="center"
 android:clickable="true" android:focusable="true" android:contentDescription="对弈"
 android:background="@drawable/jade_game_active_tab"
 android:drawableTop="@drawable/ic_game_gold" android:drawablePadding="2dp"
 android:text="对弈" android:textColor="#F6D47A" android:textSize="11sp"/>
                <TextView android:id="@+id/gameNavTraining" android:layout_width="0dp"
 android:layout_weight="1" android:layout_height="match_parent" android:gravity="center"
 android:clickable="true" android:focusable="true" android:contentDescription="训练"
 android:background="@android:color/transparent"
 android:drawableTop="@drawable/ic_training_ivory" android:drawablePadding="2dp"
 android:text="训练" android:textColor="#EAF0E4" android:textSize="11sp"/>
                <TextView android:id="@+id/gameNavSettings" android:layout_width="0dp"
 android:layout_weight="1" android:layout_height="match_parent" android:gravity="center"
 android:clickable="true" android:focusable="true" android:contentDescription="设置"
 android:background="@android:color/transparent"
 android:drawableTop="@drawable/ic_settings_ivory" android:drawablePadding="2dp"
 android:text="设置" android:textColor="#EAF0E4" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
        <!-- Keep handlers, enabled states and legacy features reachable from More. -->
        <LinearLayout android:layout_width="1dp" android:layout_height="1dp"
            android:orientation="vertical" android:visibility="gone">
            <Button android:id="@+id/resignButton" android:layout_width="1dp" android:layout_height="1dp"
 android:text="认输" android:visibility="gone"/>
            <Button android:id="@+id/newRoundButton" android:layout_width="1dp" android:layout_height="1dp"
 android:text="新开一局" android:visibility="gone"/>
            <Button android:id="@+id/countTerritoryButton" android:layout_width="1dp" android:layout_height="1dp"
 android:text="智能裁判" android:visibility="gone"/>
            <Button android:id="@+id/variationButton" android:layout_width="1dp" android:layout_height="1dp"
 android:text="后续变化" android:visibility="gone"/>
            <TextView android:id="@+id/aiDifficultyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Human SL" android:textColor="#E9DDAF" android:textSize="10sp" android:visibility="gone"/>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
