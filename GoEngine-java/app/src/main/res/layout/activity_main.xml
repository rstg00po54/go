<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.badukai.ui.GoHomeTouchLayout
        android:id="@+id/mainPageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/homeArtwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            android:contentDescription="竹林庭院围棋首页" />
        <Button
            android:id="@+id/aiBattleButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:contentDescription="人机对弈"
            android:text=""
            android:padding="0dp"
            android:stateListAnimator="@null"/>
        <Button
            android:id="@+id/homeRecordButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:contentDescription="棋谱复盘"
            android:text=""
            android:padding="0dp"
            android:stateListAnimator="@null"/>
        <Button
            android:id="@+id/homeTrainingButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:contentDescription="死活训练"
            android:text=""
            android:padding="0dp"
            android:stateListAnimator="@null"/>
        <Button
            android:id="@+id/homeSettingsButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:contentDescription="设置"
            android:text=""
            android:padding="0dp"
            android:stateListAnimator="@null"/>
        <Button
            android:id="@+id/homeTabButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:contentDescription="首页"
            android:text=""
            android:padding="0dp"
            android:stateListAnimator="@null"/>
        <Button
            android:id="@+id/homeGameTabButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:contentDescription="对弈"
            android:text=""
            android:padding="0dp"
            android:stateListAnimator="@null"/>
        <Button
            android:id="@+id/homeRecordTabButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:contentDescription="棋谱"
            android:text=""
            android:padding="0dp"
            android:stateListAnimator="@null"/>
        <Button
            android:id="@+id/homeTrainingTabButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:contentDescription="训练"
            android:text=""
            android:padding="0dp"
            android:stateListAnimator="@null"/>
        <Button
            android:id="@+id/homeSettingsTabButton"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:contentDescription="设置"
            android:text=""
            android:padding="0dp"
            android:stateListAnimator="@null"/>
    </com.badukai.ui.GoHomeTouchLayout>

    <LinearLayout
        android:id="@+id/gamePageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/txwq_game_bg"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="#E6F5EF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:text="←"
                android:textAllCaps="false"
                android:textColor="#4B8D6B"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/gameTitleText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="19路对局　常见问题　　第1手"
                android:textColor="#286B48"
                android:textSize="18sp" />

            <Button
                android:id="@+id/newGameButton"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:text="⚙"
                android:textAllCaps="false"
                android:textColor="#4B8D6B"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:background="#CFECE0"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="2dp"
                        android:id="@+id/aiStoneView"
                        android:background="@drawable/txwq_white_stone" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="围棋精灵"
                        android:textColor="#286B48"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/aiDifficultyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="简单 · 20次/0.4秒"
                    android:textColor="#286B48"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/aiCaptureText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="白棋提子 0"
                    android:textColor="#5B7B69"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/aiWinRateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:singleLine="true"
                    android:text="白胜率 --%"
                    android:textColor="#276949"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/aiMoveTimeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:singleLine="true"
                    android:text="本手用时 --"
                    android:textColor="#5B7B69"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="正在启动 AI..."
                    android:textColor="#A16B50"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/nnAreaScoreText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="黑 -- · 白 --"
                    android:textColor="#5B7B69"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="安静01006"
                        android:textColor="#286B48"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="2dp"
                        android:id="@+id/playerStoneView"
                        android:background="@drawable/txwq_black_stone" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="13级"
                    android:textColor="#286B48"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/playerCaptureText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="黑棋提子 0"
                    android:textColor="#5B7B69"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/playerWinRateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:singleLine="true"
                    android:text="黑胜率 --%"
                    android:textColor="#276949"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <com.badukai.ui.GoBoardView
            android:id="@+id/boardView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <GridLayout
            android:id="@+id/gameActionPanel"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#E2F4EE"
            android:alignmentMode="alignBounds"
            android:columnCount="4"
            android:rowCount="2"
            android:useDefaultMargins="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/resignButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/txwq_green_button"
                android:text="认输"
                android:textAllCaps="false"
                android:textColor="#FFF4CB"
                android:textSize="14sp" />

            <Button
                android:id="@+id/passButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/txwq_green_button"
                android:text="停一手"
                android:textAllCaps="false"
                android:textColor="#FFF4CB"
                android:textSize="14sp" />

            <Button
                android:id="@+id/undoButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/txwq_green_button"
                android:text="悔棋"
                android:textAllCaps="false"
                android:textColor="#FFF4CB"
                android:textSize="14sp" />

            <Button
                android:id="@+id/newRoundButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/txwq_green_button"
                android:text="新开一局"
                android:textAllCaps="false"
                android:textColor="#FFF4CB"
                android:textSize="14sp" />

            <Button
                android:id="@+id/situationButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/txwq_green_button"
                android:text="形势"
                android:textAllCaps="false"
                android:textColor="#FFF4CB"
                android:textSize="14sp" />

            <Button
                android:id="@+id/aiSuggestionButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/txwq_green_button"
                android:text="AI推荐"
                android:textAllCaps="false"
                android:textColor="#FFF4CB"
                android:textSize="14sp" />

            <Button
                android:id="@+id/countTerritoryButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/txwq_green_button"
                android:text="智能裁判"
                android:textAllCaps="false"
                android:textColor="#FFF4CB"
                android:textSize="14sp" />

            <Button
                android:id="@+id/variationButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/txwq_green_button"
                android:text="后续变化"
                android:textAllCaps="false"
                android:textColor="#FFF4CB"
                android:textSize="14sp" />
        </GridLayout>
    </LinearLayout>

</FrameLayout>
