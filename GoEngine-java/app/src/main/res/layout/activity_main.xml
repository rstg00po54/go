<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.badukai.ui.GoHomeTouchLayout
        android:id="@+id/mainPageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#193424">
        <ImageView
            android:id="@+id/homeArtwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            android:contentDescription="竹林书房与围棋雅室" />
        <View android:id="@+id/homeTopShade"
            android:layout_width="1dp" android:layout_height="1dp"
            android:importantForAccessibility="no"
            android:background="@drawable/jade_home_scrim"/>
        <TextView android:id="@+id/homeTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="竹隐 · 围棋" android:textColor="#FFF4D8"
            android:textSize="29sp" android:textStyle="bold"
            android:shadowColor="#99000000" android:shadowRadius="5"
            android:shadowDx="1" android:shadowDy="2"/>
        <TextView android:id="@+id/homeSubtitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="一局一境 · 棋落竹影" android:textColor="#F5DFAD"
            android:textSize="15sp" android:shadowColor="#BB000000"
            android:shadowRadius="3"/>
        <TextView android:id="@+id/homeLocalBadge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/jade_home_badge"
            android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:singleLine="true" android:text="本地 KataGo · 离线对弈"
            android:textColor="#254D3A" android:textSize="12sp"/>
        <Button android:id="@+id/aiBattleButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="人机对弈"
            android:padding="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/homeRecordButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="棋谱复盘"
            android:padding="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/homeTrainingButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="死活训练"
            android:padding="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/homeSettingsButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="设置"
            android:padding="0dp" android:stateListAnimator="@null" />
        <ImageView android:id="@+id/homeNavBarArtwork"
            android:layout_width="1dp" android:layout_height="1dp"
            android:scaleType="fitCenter" android:importantForAccessibility="no"
            android:contentDescription="翡翠底部导航栏" />
        <Button android:id="@+id/homeTabButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="首页"
            android:padding="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/homeGameTabButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="对弈"
            android:padding="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/homeRecordTabButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="棋谱"
            android:padding="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/homeTrainingTabButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="训练"
            android:padding="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/homeSettingsTabButton"
            android:layout_width="1dp" android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:text=""
            android:textAllCaps="false"
            android:textColor="#FFF0CB"
            android:textSize="13sp"
            android:contentDescription="设置"
            android:padding="0dp" android:stateListAnimator="@null" />
    </com.badukai.ui.GoHomeTouchLayout>

    <LinearLayout
        android:id="@+id/gamePageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/jade_game_bg"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/jade_game_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:background="@drawable/jade_header_button"
                android:text="‹"
                android:textAllCaps="false"
                android:textColor="#F8E6BB"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/gameTitleText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="19路对局　常见问题　　第1手"
                android:textColor="#F7EBCB"
                android:textSize="16sp" android:textStyle="bold" />

            <Button
                android:id="@+id/newGameButton"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:background="@drawable/jade_header_button"
                android:text="＋"
                android:textAllCaps="false"
                android:textColor="#F8E6BB"
                android:textSize="24sp" android:contentDescription="新开对局" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/jade_player_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="2dp"
                        android:id="@+id/aiStoneView"
                        android:background="@drawable/txwq_white_stone" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="KataGo · AI"
                        android:textColor="#27533E"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/aiDifficultyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="简单 · 20次/0.4秒"
                    android:textColor="#27533E"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/aiCaptureText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="白棋提子 0"
                    android:textColor="#687966"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/aiWinRateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:singleLine="true"
                    android:text="白胜率 --%"
                    android:textColor="#235A3C"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/aiMoveTimeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:singleLine="true"
                    android:text="本手用时 --"
                    android:textColor="#687966"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="正在启动 AI..."
                    android:textColor="#A16B50"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/nnAreaScoreText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="黑 -- · 白 --"
                    android:textColor="#687966"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="我"
                        android:textColor="#27533E"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="2dp"
                        android:id="@+id/playerStoneView"
                        android:background="@drawable/txwq_black_stone" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="13级"
                    android:textColor="#27533E"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/playerCaptureText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="黑棋提子 0"
                    android:textColor="#687966"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/playerWinRateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:singleLine="true"
                    android:text="黑胜率 --%"
                    android:textColor="#235A3C"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- The square board stays centered on phone and RK3588 screens. -->
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="32dp" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="15dp" android:paddingEnd="15dp">
            <TextView android:layout_width="30dp" android:layout_height="wrap_content"
                android:text="黑" android:textStyle="bold" android:textColor="#234634"
                android:textSize="12sp"/>
            <ProgressBar android:id="@+id/winRateProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp" android:layout_height="14dp"
                android:layout_weight="1" android:clickable="true"
                android:contentDescription="黑白胜率分布，点击查看胜率曲线"
                android:max="1000" android:progress="500"
                android:progressDrawable="@drawable/jade_winrate_progress"/>
            <TextView android:layout_width="30dp" android:layout_height="wrap_content"
                android:gravity="end" android:text="白" android:textStyle="bold"
                android:textColor="#685C43" android:textSize="12sp"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/boardFrame"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" android:layout_marginBottom="6dp"
            android:padding="6dp" android:background="@drawable/jade_board_frame">
            <com.badukai.ui.GoBoardView android:id="@+id/boardView"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:layout_gravity="center"/>
        </FrameLayout>

        <GridLayout
            android:id="@+id/gameActionPanel"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:background="@drawable/jade_controls_bg"
            android:alignmentMode="alignBounds"
            android:columnCount="4"
            android:rowCount="2"
            android:useDefaultMargins="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/resignButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/jade_action_danger"
                android:text="认输"
                android:textAllCaps="false"
                android:textColor="#874E3C"
                android:textSize="13sp" />

            <Button
                android:id="@+id/passButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/jade_action_secondary"
                android:text="停一手"
                android:textAllCaps="false"
                android:textColor="#244E3D"
                android:textSize="13sp" />

            <Button
                android:id="@+id/undoButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/jade_action_secondary"
                android:text="悔棋"
                android:textAllCaps="false"
                android:textColor="#244E3D"
                android:textSize="13sp" />

            <Button
                android:id="@+id/newRoundButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/jade_action_secondary"
                android:text="新开一局"
                android:textAllCaps="false"
                android:textColor="#244E3D"
                android:textSize="13sp" />

            <Button
                android:id="@+id/situationButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/jade_action_secondary"
                android:text="形势"
                android:textAllCaps="false"
                android:textColor="#244E3D"
                android:textSize="13sp" />

            <Button
                android:id="@+id/aiSuggestionButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/jade_action_primary"
                android:text="AI推荐"
                android:textAllCaps="false"
                android:textColor="#FFF3D6"
                android:textSize="13sp" />

            <Button
                android:id="@+id/countTerritoryButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/jade_action_primary"
                android:text="智能裁判"
                android:textAllCaps="false"
                android:textColor="#FFF3D6"
                android:textSize="13sp" />

            <Button
                android:id="@+id/variationButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:singleLine="true"
                android:background="@drawable/jade_action_secondary"
                android:text="后续变化"
                android:textAllCaps="false"
                android:textColor="#244E3D"
                android:textSize="13sp" />
        </GridLayout>
    </LinearLayout>

</FrameLayout>
