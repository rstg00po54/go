<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#061F19">
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/jade_forest_scrim"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="57dp"
            android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:orientation="horizontal">
            <ImageButton android:id="@+id/explainBack"
                android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/btn_round_back" android:contentDescription="返回训练"/>
            <TextView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="49dp" android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp" android:gravity="center"
                android:background="@drawable/jade_dark_title" android:text="死 活 答 案 解 析"
                android:textColor="#1A4835" android:textStyle="bold"
                android:textSize="19sp" android:fontFamily="serif"/>
            <ImageView android:layout_width="42dp" android:layout_height="42dp"
                android:padding="7dp" android:src="@drawable/ic_hint_gold"
                android:importantForAccessibility="no" android:contentDescription="@null"/>
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="65dp"
                    android:layout_margin="10dp" android:orientation="vertical"
                    android:gravity="center" android:background="@drawable/jade_dark_card">
                    <TextView android:id="@+id/explainPuzzleTitle"
                        android:layout_width="match_parent" android:layout_height="30dp"
                        android:gravity="center" android:text="第 1 题 · 答案解析"
                        android:textColor="#F4D88F" android:textSize="17sp"
                        android:textStyle="bold"/>
                    <TextView android:id="@+id/explainSide"
                        android:layout_width="match_parent" android:layout_height="24dp"
                        android:gravity="center" android:text="黑先 · 提子"
                        android:textColor="#C8D9CA" android:textSize="12sp"/>
                </LinearLayout>
                <com.badukai.ui.JadeSquareBoardFrame android:id="@+id/explainBoardFrame"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                    android:layout_marginBottom="10dp" android:padding="7dp"
                    android:background="@drawable/jade_game_wood_panel">
                    <com.badukai.ui.GoBoardView android:id="@+id/explainBoard"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:contentDescription="正确答案棋盘，不可落子"/>
                </com.badukai.ui.JadeSquareBoardFrame>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="142dp" android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp" android:layout_marginBottom="10dp"
                    android:background="@drawable/jade_dark_card" android:orientation="vertical"
                    android:padding="14dp">
                    <TextView android:id="@+id/explainAnswer"
                        android:layout_width="match_parent" android:layout_height="29dp"
                        android:text="正确落点 --" android:textColor="#F7D985"
                        android:textStyle="bold" android:textSize="18sp"/>
                    <TextView android:id="@+id/explainBody"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="找到整块棋最后的一口气，才能正确提子。"
                        android:textColor="#E4EADC" android:textSize="14sp"
                        android:lineSpacingExtra="5dp"/>
                    <TextView android:id="@+id/explainAttempts"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="已完成本题" android:textColor="#B7D8C8"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/jade_dark_footer"
            android:paddingStart="10dp" android:paddingEnd="10dp">
            <Button android:id="@+id/explainReturn"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="46dp" android:layout_marginEnd="5dp"
                android:background="@drawable/jade_game_white_button"
                android:text="返回练习" android:textAllCaps="false"
                android:textColor="#164A38" android:textSize="14sp"
                android:minWidth="0dp" android:minHeight="0dp"/>
            <Button android:id="@+id/explainNext"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="46dp" android:layout_marginStart="5dp"
                android:background="@drawable/jade_game_white_button"
                android:text="下一题 ›" android:textAllCaps="false"
                android:textColor="#164A38" android:textSize="14sp"
                android:minWidth="0dp" android:minHeight="0dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
