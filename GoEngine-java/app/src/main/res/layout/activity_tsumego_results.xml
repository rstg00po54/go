<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#061F19">
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/jade_forest_scrim" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp"
            android:gravity="center_vertical" android:paddingStart="10dp"
            android:paddingEnd="10dp" android:orientation="horizontal">
            <ImageButton android:id="@+id/resultsBack"
                android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/btn_round_back" android:contentDescription="返回训练"/>
            <TextView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="49dp" android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp" android:gravity="center"
                android:background="@drawable/jade_dark_title"
                android:text="训 练 结 果" android:fontFamily="serif"
                android:textColor="#174534" android:textSize="20sp" android:textStyle="bold"/>
            <ImageView android:layout_width="42dp" android:layout_height="42dp"
                android:padding="7dp" android:src="@drawable/ic_difficulty_gold"
                android:importantForAccessibility="no" android:contentDescription="@null"/>
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="141dp" android:layout_margin="11dp"
                    android:background="@drawable/jade_dark_card"
                    android:padding="13dp" android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="match_parent" android:layout_height="27dp"
                        android:gravity="center" android:text="八道基础死活题"
                        android:textSize="15sp" android:textColor="#D3E6CC"/>
                    <TextView android:id="@+id/resultsScore"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:gravity="center" android:text="0 / 8"
                        android:textColor="#F8D58D" android:textSize="38sp" android:textStyle="bold"/>
                    <ProgressBar android:id="@+id/resultsProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="9dp"
                        android:max="100" android:progress="0"
                        android:progressTint="#2CD8A1" android:thumbTint="#F6D585"
                        android:progressBackgroundTint="#507866"/>
                    <TextView android:id="@+id/resultsSummary"
                        android:layout_width="match_parent" android:layout_height="28dp"
                        android:gravity="center" android:text="已完成 0 题，还有 8 题待练习"
                        android:textSize="12sp" android:textColor="#D8E6D1"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="36dp"
                    android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                    android:gravity="center_vertical" android:text="逐题完成情况"
                    android:textColor="#F6D58D" android:textSize="16sp" android:textStyle="bold"/>
                <LinearLayout android:id="@+id/resultsPuzzleList"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingStart="11dp" android:paddingEnd="11dp"
                    android:orientation="vertical"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_margin="14dp" android:gravity="center" android:padding="10dp"
                    android:text="点击任意题目即可继续练习。完成记录只在本地保存。"
                    android:textColor="#BBD7C8" android:textSize="11sp"/>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="62dp"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="11dp" android:paddingEnd="11dp"
            android:background="@drawable/jade_dark_footer">
            <Button android:id="@+id/resultsReturn"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="47dp" android:layout_marginEnd="5dp"
                android:background="@drawable/jade_game_white_button"
                android:text="返回训练" android:textAllCaps="false"
                android:textColor="#15523A" android:textSize="14sp"
                android:minWidth="0dp" android:minHeight="0dp"/>
            <Button android:id="@+id/resultsContinue"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="47dp" android:layout_marginStart="5dp"
                android:background="@drawable/jade_game_white_button"
                android:text="继续闯关" android:textAllCaps="false"
                android:textColor="#15523A" android:textSize="14sp"
                android:minWidth="0dp" android:minHeight="0dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
