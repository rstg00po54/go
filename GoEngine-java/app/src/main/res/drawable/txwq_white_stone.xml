<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#40000000" />
        </shape>
    </item>
    <item android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="23dp"
                android:centerX="0.27" android:centerY="0.23"
                android:startColor="#FFFFFF" android:centerColor="#F0F2EF"
                android:endColor="#A4ACA6" />
            <stroke android:width="0.65dp" android:color="#8B9790" />
        </shape>
    </item>
</layer-list>
