<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#1E4736"/>
            <corners android:radius="13dp"/></shape>
    </item>
    <item><shape android:shape="rectangle">
        <gradient android:angle="0" android:startColor="#234E3C" android:endColor="#42795B"/>
        <stroke android:width="1dp" android:color="#C8A66B"/>
        <corners android:radius="13dp"/>
    </shape></item>
</selector>
